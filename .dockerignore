# Ignore all hidden files and directories (.git, .github, .vscode, .bundle, .env)
.*
!.

# Documentation and repository configuration
/AGENTS.md
/README.md
/docs/
/Dockerfile
/dockerized.sh
/justfile
/Justfile
/LICENSE
/bin/lefthook

# Repository configuration not required by the image
/*.toml
/*.yml
/*.yaml

# Project metadata not required by the image
/skills-lock.json

# Test and type-signature sources not required by the image
/test/
/spec/
/sig/
/data/

# Logs, temporary files, storage, keys
/log/
/tmp/
/coverage/
/vendor/
/node_modules/
/config/master.key
/config/credentials/*.key
/storage/
/public/assets/
